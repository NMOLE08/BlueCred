{
  "name": "blue-carbon-registry",
  "version": "1.0.0",
  "description": "Blockchain-based Blue Carbon Registry and MRV System",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "node": "hardhat node --port 8546",
    "start": "cd frontend && npm start",
    "install-frontend": "cd frontend && npm install",
    "dev": "concurrently \"npm run node\" \"npm run deploy\" \"npm run start\"",
    "setup": "npm install && npm run install-frontend && npm run compile"
  },
  "keywords": [
    "blockchain",
    "carbon-credits",
    "blue-carbon",
    "ethereum"
  ],
  "author": "Blue Carbon Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "concurrently": "^8.2.2",
    "hardhat": "^2.19.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "ethers": "^6.8.0"
  }
}
